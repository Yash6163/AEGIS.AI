{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && LOG_JSON=false ../.venv/bin/python -m uvicorn aegis.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && BACKEND_URL=http://127.0.0.1:8000 npm run dev -- -p 3000"],
      "port": 3000
    }
  ]
}
