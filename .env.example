# ==============================================================================
# AEGIS.AI // PREDICTIVE CYBER DEFENCE PLATFORM
# Environment Configuration Template (SIH Production Readiness)
# ==============================================================================

# Application Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Simulation / Heuristic vs Live API Mode
# When 'true', platform utilizes high-fidelity synthetic SOC heuristics.
# Set to 'false' to route calls to the backend inference microservice.
NEXT_PUBLIC_ENABLE_MOCK_SERVICES=true

# Python ML & TGNN Inference Backend (FastAPI / PyTorch)
# Leave blank or configure your dedicated inference server
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_ENGINE_TIMEOUT_MS=5000

# Blockchain / Ledger RPC Endpoint (Hyperledger Besu / Ethereum Sepolia / Polygon Supernets)
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://localhost:8545
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=1337
NEXT_PUBLIC_BLOCKCHAIN_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# Decentralized Threat Intelligence Nexus (STIX 2.1 / TAXII 2.1 Server)
NEXT_PUBLIC_TAXII_FEED_URL=https://threat-intel.aegis-cyber.local/taxii2/
NEXT_PUBLIC_TAXII_COLLECTION_ID=f81d4fae-7dec-11d0-a765-00a0c91e6bf6

# Node Telemetry Metadata
NEXT_PUBLIC_CLUSTER_REGION=IND-WEST-01
NEXT_PUBLIC_NODE_ID=SOC-NODE-ALPHA-2026
