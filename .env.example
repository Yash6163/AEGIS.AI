# Copy to .env and fill in. Never commit .env.
# ---- docker compose -------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password
# 32+ random chars, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
SECRET_KEY=change-me
# Required for write endpoints in production; the web console's server-side proxy sends it.
API_KEY=change-me
CORS_ORIGINS=http://localhost:3000
WEB_PORT=3000
LOG_LEVEL=INFO

# ---- local development (backend) -------------------------------------------
# APP_ENV=development            # development | test | production
# DATABASE_URL=sqlite:///./aegis.db
# MODEL_DIR=../models/aegis-wm-1.1.0
# SCENARIO_PATH=../data/scenarios/cicids2017_replay.npz
# RATE_LIMIT_PER_MINUTE=240
# MAX_UPLOAD_MB=50
# MAX_UNCOMPRESSED_MB=512
# MC_SAMPLES=512
# ANONYMIZE_UPLOADS=true
# LOG_JSON=true

# ---- local development (frontend, server-side only) ------------------------
# BACKEND_URL=http://localhost:8000
